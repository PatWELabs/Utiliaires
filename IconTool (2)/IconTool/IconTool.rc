/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_ICONTOOL MENU 
BEGIN
    MENUITEM "Ouvrir un dossier",           ID_OUVRIRUNDOSSIER
    POPUP "Affichage"
    BEGIN
        MENUITEM "Liste",                       ID_AFFICHAGE_LISTE
        MENUITEM "Petites icones",              ID_AFFICHAGE_PETITESICONES
        MENUITEM "Grandes icones",              ID_AFFICHAGE_GRANDESICONES
        MENUITEM SEPARATOR
        MENUITEM "Detaille",                    ID_AFFICHAGE_DETAILLE
    END
    MENUITEM "Reinitialiser la liste",      ID_REINITIALISERLALISTE
    MENUITEM "&About ...",                  IDM_ABOUT
    MENUITEM "E&xit",                       IDM_EXIT
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDC_ICONTOOL ACCELERATORS 
BEGIN
    "?",            IDM_ABOUT,              ASCII,  ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 22, 17, 168, 74
STYLE DS_SETFONT | DS_MODALFRAME | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 8, "System", 0, 0, 0x0
BEGIN
    ICON            IDI_SMALL,IDC_MYICON,14,9,20,20
    LTEXT           "IconTool Version 1.0",IDC_STATIC,49,10,119,8,
                    SS_NOPREFIX
    LTEXT           "Copyright (C) 2020",IDC_STATIC,49,20,119,8
    DEFPUSHBUTTON   "OK",IDOK,135,60,30,11,WS_GROUP
END


