/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_COMMIS2ENTREPOT2022 MENU 
BEGIN
    POPUP "&Fichier"
    BEGIN
        MENUITEM "&Noveau",                     CM_FILE_NEW
        MENUITEM "&Ouvrir",                     CM_FILE_OPEN
        MENUITEM "&Sauvegarder",                CM_FILE_SAVE
        MENUITEM "Sauvegarder so&us",           CM_FILE_SAVEAS
        MENUITEM SEPARATOR
        MENUITEM "Supprimer",                   ID_FICHIER_SUPPRIMER
    END
    POPUP "&Edition textuelle"
    BEGIN
        MENUITEM "&Defaire\tCtrl+Z",            CM_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Couper\tCtrl+X",              CM_EDIT_CUT
        MENUITEM "&Copier\tCtrl+C",             CM_EDIT_COPY
        MENUITEM "&Coller\tCtrl+V",             CM_EDIT_PASTE
    END
    POPUP "&Window"
    BEGIN
        MENUITEM "&Cascade",                    CM_WINDOW_CASCADE
        MENUITEM "Horizontalement",             CM_WINDOW_TILEHORZ
        MENUITEM "Verticalement",               CM_WINDOW_TILEVERT
        MENUITEM "Reorganisation automatique",  CM_WINDOW_ARRANGE
    END
    POPUP "Aide"
    BEGIN
        MENUITEM "A propos de cette apllication", IDM_ABOUT
        MENUITEM "Visitez le site de l'auteur", ID_AIDE_VISITEZLESITEDEL
        MENUITEM SEPARATOR
        MENUITEM "Envoyez nous vos commentaires", ID_AIDE_ENVOYEZNOUSVOSCOMMENTAIRES
        MENUITEM "Signaler un bug",             ID_AIDE_SIGNALERUNBUG
    END
    MENUITEM "Quitter et revenir a Windows", CM_FILE_EXIT
END


