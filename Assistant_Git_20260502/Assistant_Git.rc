/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU
BEGIN
	POPUP "&Fichier"
	BEGIN
		MENUITEM "&Nouveau\tCtrl+N",                ID_FILE_NEW
		MENUITEM "&Ouvrir...\tCtrl+O",            ID_FILE_OPEN
		MENUITEM "&Fermer",                      ID_FILE_CLOSE
		MENUITEM SEPARATOR
		MENUITEM "Fichier récent",                 ID_FILE_MRU_FILE1,GRAYED
		MENUITEM SEPARATOR
		MENUITEM "&quitter",                       ID_APP_EXIT
	END
	POPUP "&Affichage"
	BEGIN
		MENUITEM "&barre d'état",                 ID_VIEW_STATUS_BAR
	END
	POPUP "&Aide"
	BEGIN
		MENUITEM "&À propos de Assistant_Git...",          ID_APP_ABOUT
	END
END

IDR_Assistant_GitTYPE MENU
BEGIN
	POPUP "&Fichier"
	BEGIN
		MENUITEM "&Nouveau\tCtrl+N",                ID_FILE_NEW
		MENUITEM "&Ouvrir...\tCtrl+O",            ID_FILE_OPEN
		MENUITEM "&Fermer",                      ID_FILE_CLOSE
		MENUITEM "&Enregistrer\tCtrl+S",               ID_FILE_SAVE
		MENUITEM "Enregistrer &sous...",                 ID_FILE_SAVE_AS
		MENUITEM SEPARATOR
		MENUITEM "Fichier récent",                 ID_FILE_MRU_FILE1,GRAYED
		MENUITEM SEPARATOR
		MENUITEM "&quitter",                       ID_APP_EXIT
	END
	POPUP "&Edition"
	BEGIN
		MENUITEM "&Annuler\tCtrl+Z",               ID_EDIT_UNDO
		MENUITEM SEPARATOR
		MENUITEM "&Couper\tCtrl+X",                ID_EDIT_CUT
		MENUITEM "C&opier\tCtrl+C",               ID_EDIT_COPY
		MENUITEM "Co&ller\tCtrl+V",              ID_EDIT_PASTE
	END
	POPUP "&Affichage"
	BEGIN
		MENUITEM "&barre d'état",                 ID_VIEW_STATUS_BAR
	END
	POPUP "&Fenêtre"
	BEGIN
		MENUITEM "&Nouvelle fenêtre",                 ID_WINDOW_NEW
	END
	POPUP "&Aide"
	BEGIN
		MENUITEM "&À propos de Assistant_Git...",          ID_APP_ABOUT
	END
END




IDR_POPUP_EDIT MENU
BEGIN
	POPUP "Edition"
	BEGIN
		MENUITEM "&Couper\tCtrl+X",            ID_EDIT_CUT
		MENUITEM "C&opier\tCtrl+C",           ID_EDIT_COPY
		MENUITEM "Co&ller\tCtrl+V",          ID_EDIT_PASTE
	END
END

IDR_WINDOWS_MENU MENU
BEGIN
    MENUITEM "&Nouvelle fenêtre",                 ID_WINDOW_NEW
END

IDR_POPUP_SORT MENU
BEGIN
    POPUP "Tri"
    BEGIN
        MENUITEM "Tr&ier par ordre alphabétique",         ID_SORTING_SORTALPHABETIC
        MENUITEM "Tri&er par type",               ID_SORTING_SORTBYTYPE
        MENUITEM "Trier par a&ccès",             ID_SORTING_SORTBYACCESS
        MENUITEM "&Grouper par type",              ID_SORTING_GROUPBYTYPE
    END
END

IDR_POPUP_EXPLORER MENU
BEGIN
    POPUP "Explorateur"
    BEGIN
        MENUITEM "&Ouvrir",                       ID_OPEN
        MENUITEM "Ou&vrir avec...",              ID_OPEN_WITH
        MENUITEM SEPARATOR
        MENUITEM "&Compiler",                    ID_DUMMY_COMPILE
        MENUITEM SEPARATOR
        MENUITEM "&Couper\tCtrl+X",                ID_EDIT_CUT
        MENUITEM "C&opier\tCtrl+C",               ID_EDIT_COPY
        MENUITEM "Supp&rimer",                     ID_EDIT_CLEAR
        MENUITEM SEPARATOR
        MENUITEM "Pr&opriétés...",              ID_PROPERTIES
    END
END

/////////////////////////////////////////////////////////////////////////////
//
// Accélérateur
//

IDR_MAINFRAME ACCELERATORS
BEGIN
	"N",            ID_FILE_NEW,            VIRTKEY,CONTROL
	"O",            ID_FILE_OPEN,           VIRTKEY,CONTROL
	"S",            ID_FILE_SAVE,           VIRTKEY,CONTROL
	"e",            ID_EDIT_UNDO,           VIRTKEY,CONTROL
	"X",            ID_EDIT_CUT,            VIRTKEY,CONTROL
	"P",            ID_EDIT_COPY,           VIRTKEY,CONTROL
	"V",            ID_EDIT_PASTE,          VIRTKEY,CONTROL
	VK_BACK,        ID_EDIT_UNDO,           VIRTKEY,ALT
	VK_DELETE,      ID_EDIT_CUT,            VIRTKEY,SHIFT
	VK_INSERT,      ID_EDIT_COPY,           VIRTKEY,CONTROL
	VK_INSERT,      ID_EDIT_PASTE,          VIRTKEY,SHIFT
	VK_F6,          ID_NEXT_PANE,           VIRTKEY
	VK_F6,          ID_PREV_PANE,           VIRTKEY,SHIFT
END




/////////////////////////////////////////////////////////////////////////////
//
// Boîte de dialogue
//

IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "À propos de Assistant_Git"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,14,14,21,20
    LTEXT           "Assistant_Git, version 1.0",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2022",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "OK",IDOK,113,41,50,14,WS_GROUP
END

IDD_ASSISTANT_GIT_FORM	DIALOGEX  0, 0, 320, 200
STYLE DS_SHELLFONT | WS_CHILD
FONT 8, "MS Shell Dlg"
BEGIN
	LTEXT	"TODO : placez les contrôles du formulaire dans cette boîte de dialogue.",IDC_STATIC,24,42,
		280,8
END


/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO     VERSIONINFO
  FILEVERSION       1,0,0,1
  PRODUCTVERSION    1,0,0,1
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
        BLOCK "040c04e4"
		BEGIN
            VALUE "CompanyName", "TODO : <Nom de la société>"
            VALUE "FileDescription", "TODO : <Description de fichier>"
			VALUE "FileVersion",     "1.0.0.1"
			VALUE "InternalName",    "Assistant_Git.exe"
            VALUE "LegalCopyright", "TODO : (c) <Nom de la société>. Tous droits réservés."
			VALUE "OriginalFilename","Assistant_Git.exe"
            VALUE "ProductName", "TODO : <Nom du produit>"
			VALUE "ProductVersion",  "1.0.0.1"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x040c, 1252
    END
END

