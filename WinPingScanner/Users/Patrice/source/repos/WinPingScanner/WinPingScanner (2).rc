// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_WINPINGSCANNER      ICON    DISCARDABLE     "WinPingScanner.ICO"
IDI_SMALL               ICON    DISCARDABLE     "SMALL.ICO"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_WINPINGSCANNER MENU DISCARDABLE 
BEGIN
    MENUITEM "IP Scan",                     ID_IPSCAN
    MENUITEM "&About ...",                  IDM_ABOUT
    MENUITEM "E&xit",                       IDM_EXIT
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDC_WINPINGSCANNER ACCELERATORS MOVEABLE PURE 
BEGIN
    "?",            IDM_ABOUT,              ASCII,  ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
END


